# 服务器配置
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT 配置
# 请设置一个安全的密钥，建议使用随机生成的字符串
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRES_IN=8h

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fall_detection_system

# 数据库类型选择：json 或 mysql
DB_TYPE=json

# 路径配置
UPLOADS_DIR=./uploads
FALLS_VIDEOS_DIR=./falls_videos
PYTHON_DIR=./python

# 视频配置
MAX_VIDEO_SIZE=100mb

# 检测配置
DETECTION_INTERVAL=2000
MAX_RECORDING_SLICE=3
